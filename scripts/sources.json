{
 "_doc": "Sources par technologie. Clé = nom exact (insensible à la casse) de technologies.csv. Champs : category, github (owner/repo, releases), feeds (RSS/Atom officiels), query (recherche actualités), site (lien officiel). Toute techno absente ici est suivie via la recherche d'actualités sur son nom. cve : mot-clé (expression exacte) cherché dans les CVE de la NVD ; chaîne vide pour désactiver. match : termes dont au moins un doit figurer dans le titre d'un article (défaut : le nom). exclure : expressions régulières de titres à écarter pour cette technologie. cpe : motifs 'éditeur:produit' (jokers *) des identifiants CPE NVD ; une CVE déjà analysée qui ne vise aucun de ces produits est écartée, et la version installée (3e colonne du CSV) est comparée aux plages vulnérables.",
 "_filtres": {
  "_doc": "Filtres globaux appliqués aux actualités Google News. titres_exclus : expressions régulières (insensibles à la casse) écartant un article par son titre. sources_exclues : médias écartés. mots_exclus_recherche : termes exclus directement dans la requête Google News.",
  "mots_exclus_recherche": [
   "promo",
   "\"code promo\"",
   "soldes",
   "\"bon plan\"",
   "\"bons plans\"",
   "coupon",
   "deals",
   "\"black friday\"",
   "\"cyber monday\"",
   "\"prime day\"",
   "sponsored",
   "sponsorisé"
  ],
  "titres_exclus": [
   "\\b(promo(tion)?s?|soldes?|bons? plans?|deals?|coupons?|réduction|remise|discount|black friday|cyber monday|prime day|on sale|en solde|price drop|baisse de prix|vente flash|offre spéciale|sponsoris|sponsored|giveaway|concours|à gagner)\\b",
   "([$€£]\\s?\\d|\\d+([.,]\\d+)?\\s?(€|\\$|euros?|dollars?)\\b|\\d+\\s?% (off|de réduction|moins cher))",
   "\\b(best|meilleur(e)?s?|top \\d+|les \\d+ meilleur)",
   "\\b(vs\\.?|versus)\\b",
   "\\b(alternatives?|comparatif|comparison|on a testé|we('ve)? tested|nos tests|review|avis \\w+ \\(20\\d\\d\\))\\b",
   "\\b\\d+\\s+(steps?|étapes|min)\\b",
   "^\\s*(how to|comment|tuto|guide|tutorial)\\b",
   "^\\s*(\\d+|cinq|six|sept|huit|neuf|dix|three|four|five|six|seven|eight|nine|ten)\\s+\\w+",
   "^\\s*(i|i'm|i've|my|here's|voici|j'ai)\\b",
   "\\bcodes?\\b.*\\((novembre|november|décembre|december|janvier|january|20\\d\\d)",
   "\\b(horoscope|casino|betting|paris sportifs|crypto(currency)? price|stock price|cours de l'action|shares? (rise|fall|jump))\\b"
  ],
  "sources_exclues": [
   "tech-insider.org",
   "shattered.io",
   "troypoint",
   "hostingadvice",
   "pocket tactics",
   "gamerant",
   "beebom",
   "dexerto",
   "kalkine",
   "tipranks",
   "youtube",
   "howl.link",
   "fourweekmba",
   "pluang",
   "orcarouter",
   "h2s media",
   "technobezz",
   "jablickar"
  ]
 },
